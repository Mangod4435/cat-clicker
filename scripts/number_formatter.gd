static func format_double(n: float) -> String:
	if n > 9.99e+302:
		return "Infinity"
	if n < 1000.0:
		return str(int(round(n)))

	var tier := 0
	while n >= 1000.0 and tier < NAMES.size() - 1:
		n /= 1000.0
		tier += 1

	# "0.##" in C#: up to two decimals, no trailing zeros
	var s := "%.2f" % n
	if s.contains("."):
		s = s.rstrip("0").rstrip(".")
	return s + NAMES[tier]
